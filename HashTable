#ifndef HASHTABLE_H
#define HASHTABLE_H

#include <iostream>
#include "parcel.h"
using namespace std;

class HashTable {
private:
    static const int TABLE_SIZE = 101;
    parcel* table[TABLE_SIZE];

    int hash(int key) const;

public:
    HashTable();
    void insert(parcel* p);
    parcel* search(int parcelID) const;
};
 
HashTable::HashTable() {
    for (int i = 0; i < TABLE_SIZE; i++)
        table[i] = nullptr;
}

int HashTable::hash(int key) const {
    return key % TABLE_SIZE;
}

void HashTable::insert(parcel* p) {
    int idx = hash(p->parcelID);
    table[idx] = p;
}

parcel* HashTable::search(int parcelID) const {
    int idx = hash(parcelID);
    if (table[idx] && table[idx]->parcelID == parcelID)
        return table[idx];
    return nullptr;
}


#endif
